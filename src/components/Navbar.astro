---
import { t, languages, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<nav class="fixed top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-200/60">
  <div class="px-3 sm:px-6 lg:px-10">
    <div class="flex h-16 items-center justify-between">
      <a href={localePath(lang)} class="flex items-center gap-2 shrink-0">
        <img src="/images/logo.png" alt="Cantieri AI logo" width="266" height="276" class="h-8 w-auto" />
        <img src="/images/logo_cantieri_black.png" alt="Cantieri AI" width="558" height="110" class="h-5 w-auto" />
      </a>

      <div class="hidden lg:flex items-center gap-5 xl:gap-7">
        <a href={`${localePath(lang)}#features`} data-gtm="nav_funzionalita" class="text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors whitespace-nowrap">
          {t(lang, 'nav.features')}
        </a>
        <a href={`${localePath(lang)}#solutions`} data-gtm="nav_soluzioni" class="text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors whitespace-nowrap">
          {t(lang, 'nav.solutions')}
        </a>
        <a href={'/blog/'} data-gtm="nav_blog" class="text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors whitespace-nowrap">
          {t(lang, 'nav.blog')}
        </a>
        <a href={lang === 'it' ? '/faq/' : `/${lang}/faq/`} data-gtm="nav_faq" class="text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors whitespace-nowrap">
          {t(lang, 'nav.faq')}
        </a>
        <a href={lang === 'it' ? '/contattaci/' : lang === 'en' ? '/en/contact/' : '/ar/contact/'} data-gtm="nav_contattaci" class="text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors whitespace-nowrap">
          {t(lang, 'nav.contact')}
        </a>
        <div class="relative">
          <svg class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.97.633-3.794 1.708-5.282" />
          </svg>
          <select
            id="lang-select-desktop"
            class="appearance-none bg-slate-50 border border-slate-200 rounded-md pl-7 pr-7 py-1.5 text-xs font-medium text-slate-600 cursor-pointer hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
          >
            {Object.entries(languages).map(([code, label]) => (
              <option value={localePath(code as Lang)} selected={code === lang}>
                {label}
              </option>
            ))}
          </select>
          <svg class="pointer-events-none absolute right-1.5 top-1/2 -translate-y-1/2 h-3 w-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
        <a
          href="https://app.cantieri.ai/login"
          data-gtm="cta_nav_accedi"
          class="rounded-md bg-primary-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 transition-colors whitespace-nowrap"
        >
          {t(lang, 'nav.login')}
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-600 cursor-pointer" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200/60 bg-white/95 backdrop-blur-md">
    <div class="px-6 py-4 space-y-3">
      <a href={`${localePath(lang)}#features`} data-gtm="nav_funzionalita_mobile" class="block text-sm font-medium text-slate-600">
        {t(lang, 'nav.features')}
      </a>
      <a href={`${localePath(lang)}#solutions`} data-gtm="nav_soluzioni_mobile" class="block text-sm font-medium text-slate-600">
        {t(lang, 'nav.solutions')}
      </a>
      <a href={'/blog/'} data-gtm="nav_blog_mobile" class="block text-sm font-medium text-slate-600">
        {t(lang, 'nav.blog')}
      </a>
      <a href={lang === 'it' ? '/faq/' : `/${lang}/faq/`} data-gtm="nav_faq_mobile" class="block text-sm font-medium text-slate-600">
        {t(lang, 'nav.faq')}
      </a>
      <a href={lang === 'it' ? '/contattaci/' : lang === 'en' ? '/en/contact/' : '/ar/contact/'} data-gtm="nav_contattaci_mobile" class="block text-sm font-medium text-slate-600">
        {t(lang, 'nav.contact')}
      </a>
      <div class="relative inline-block">
        <svg class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.97.633-3.794 1.708-5.282" />
        </svg>
        <select
          id="lang-select-mobile"
          class="appearance-none bg-slate-50 border border-slate-200 rounded-md pl-7 pr-7 py-1.5 text-xs font-medium text-slate-600 cursor-pointer hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
        >
          {Object.entries(languages).map(([code, label]) => (
            <option value={localePath(code as Lang)} selected={code === lang}>
              {label}
            </option>
          ))}
        </select>
        <svg class="pointer-events-none absolute right-1.5 top-1/2 -translate-y-1/2 h-3 w-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
      <a
        href="https://app.cantieri.ai/login"
        data-gtm="cta_nav_accedi_mobile"
        class="block rounded-md bg-primary-500 px-4 py-2 text-sm font-semibold text-white text-center"
      >
        {t(lang, 'nav.login')}
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  document.querySelectorAll<HTMLSelectElement>('#lang-select-desktop, #lang-select-mobile').forEach((sel) => {
    sel.addEventListener('change', () => {
      window.location.href = sel.value;
    });
  });
</script>
