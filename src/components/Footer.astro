---
import { t, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-slate-800 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={localePath(lang)} class="flex items-center gap-2">
          <img src="/images/logo.png" alt="Cantieri AI logo" width="266" height="276" class="h-8 w-auto brightness-200" />
          <img src="/images/logo_cantieri.png" alt="Cantieri AI" width="691" height="158" class="h-5 w-auto" />
        </a>
        <p class="mt-4 text-sm leading-6">
          {t(lang, 'footer.description')}
        </p>
        <div class="mt-4 flex items-center gap-4">
          <a href="https://www.instagram.com/cantieri.ai/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" data-gtm="cta_footer_instagram" class="text-slate-400 hover:text-white transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold text-white">{t(lang, 'footer.product')}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={`${localePath(lang)}#features`} data-gtm="footer_funzionalita" class="text-sm hover:text-white transition-colors">
              {t(lang, 'nav.features')}
            </a>
          </li>
          <li>
            <a href={`${localePath(lang)}#solutions`} data-gtm="footer_soluzioni" class="text-sm hover:text-white transition-colors">
              {t(lang, 'nav.solutions')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-white">{t(lang, 'footer.company')}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={lang === 'it' ? '/blog/' : `/${lang}/blog/`} data-gtm="footer_blog" class="text-sm hover:text-white transition-colors">
              {t(lang, 'footer.blog')}
            </a>
          </li>
          <li>
            <a href={lang === 'it' ? '/faq/' : `/${lang}/faq/`} data-gtm="footer_faq" class="text-sm hover:text-white transition-colors">
              {t(lang, 'footer.faq')}
            </a>
          </li>
          <li>
            <a href={lang === 'it' ? '/contattaci' : lang === 'en' ? '/en/contact' : '/ar/contact'} data-gtm="footer_contattaci" class="text-sm hover:text-white transition-colors">
              {t(lang, 'footer.contact')}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Legal info -->
    <div class="mt-12 border-t border-slate-700/50 pt-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <div class="flex flex-col items-center gap-1.5 sm:flex-row sm:gap-4 text-center">
          <span>Piazza Sergio Finocchi, 3 — 41017 Spilamberto (MO)</span>
          <span class="hidden sm:inline">·</span>
          <a href="tel:+393480407500" data-gtm="cta_footer_telefono" class="hover:text-white transition-colors">Tel. 348.0407500</a>
          <span class="hidden sm:inline">·</span>
          <a href="mailto:info@cantieri.ai" data-gtm="cta_footer_email" class="hover:text-white transition-colors">info@cantieri.ai</a>
          <span class="hidden sm:inline">·</span>
          <span>P.IVA: 03447571203</span>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500 text-center">
        &copy; {year} Cantieri. {t(lang, 'footer.rights')}
      </p>
    </div>
  </div>
</footer>
